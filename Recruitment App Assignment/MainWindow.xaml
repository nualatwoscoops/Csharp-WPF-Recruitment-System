<Window x:Class="Recruitment_App_Assignment.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="NuCorp Contractor Recruitment Management System" Height="650" Width="650"
        FontSize="12">
    <!-- === CONTRACTOR MANAGEMENT === -->
    <Grid Margin="0,0,0,-39">

        <!-- === CONTRACTOR MANAGEMENT: Creation and List === -->

        <Label Content="Add Contractor" FontWeight="Bold" FontSize="10" Margin="5,0,0,248" HorizontalAlignment="Left" Width="108"/>
        <Label Content="First Name:" HorizontalAlignment="Left" Margin="28,25,0,0" VerticalAlignment="Top" RenderTransformOrigin="-0.297,-0.928"/>
        <Label Content="Last Name:" HorizontalAlignment="Left" Margin="29,55,0,0" VerticalAlignment="Top"/>
        <Label Content="Start Date:" HorizontalAlignment="Left" Margin="32,99,0,0" VerticalAlignment="Top" RenderTransformOrigin="-0.58,-1.118"/>
        <Label Content="Hourly Rate ($):" HorizontalAlignment="Left" Margin="5,136,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="FirstNameBox" HorizontalAlignment="Left" Height="26" Margin="102,25,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="119"/>
        <TextBox x:Name="LastNameBox" HorizontalAlignment="Left" Height="26" Margin="102,62,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="119"/>
        <DatePicker x:Name="StartDatePicker" HorizontalAlignment="Left" Margin="102,96,0,0" VerticalAlignment="Top" Height="35" Width="119"/>
        <ComboBox x:Name="HourlyRate_ComboBox" HorizontalAlignment="Left" Margin="102,138,0,0" VerticalAlignment="Top" Width="119" ItemsSource="{Binding StandardHourlyRates}" SelectedIndex="0"/>
        <Button x:Name="Button_AddContractor" Content="Add Contractor" HorizontalAlignment="Left" Margin="102,170,0,0" VerticalAlignment="Top" Width="119" Click="Button_AddContractor_Click" Height="27"/>

        <!-- Contractor Filters -->
        <TextBlock Text="Filter Contractors By:" 
               HorizontalAlignment="Left" 
               Margin="489,25,0,0"
               VerticalAlignment="Top" 
               Width="156" 
               FontWeight="Bold"/>

        <ComboBox x:Name="ContractorFilter_ComboBox" 
              HorizontalAlignment="Left" 
              Margin="489,55,0,0"
              VerticalAlignment="Top" 
              Width="129"
              SelectionChanged="ContractorFilter_ComboBox_SelectionChanged" Height="26">
            <ComboBoxItem Content="All Contractors"/>
            <ComboBoxItem Content="Available Only"/>
            <ComboBoxItem Content="Unavailable Only"/>
        </ComboBox>

        <!-- Contractor List -->
        <ListBox x:Name="Contractors_ListBox" HorizontalAlignment="Left" Height="168" Margin="250,25,0,0" SelectionMode="Single" VerticalAlignment="Top" Width="215"/>

        <!-- Contractor Action Buttons -->
        <Button x:Name="Button_Remove_Contractors" Content="Remove Contractors" HorizontalAlignment="Left" Margin="489,104,0,0" VerticalAlignment="Top" Width="132" Height="27" Click="Button_Remove_Contractors_Click"/>

        <!-- === JOB MANAGEMENT: View and Actions === -->

        <!-- Assign contractor button (Link between lists) -->
        <Button x:Name="Button_AssignContractor" Content="Assign Selected Contractor to Selected Job" HorizontalAlignment="Left" Width="250" Height="27" Click="Button_AssignContractor_Click" Margin="250,209,0,0" VerticalAlignment="Top"/>

        <!-- Job Action Panel (Filter and Complete Button) -->
        <TextBlock Text="Filter Jobs By:"
               HorizontalAlignment="Left"
               Margin="489,316,0,0"
               VerticalAlignment="Top"
               Width="100"
               FontWeight="Bold"/>

        <ComboBox x:Name="JobFilter_ComboBox"
              HorizontalAlignment="Left"
              Margin="489,341,0,0"
              VerticalAlignment="Top"
              Width="132"
              SelectionChanged="JobFilter_ComboBox_SelectionChanged">
            <ComboBoxItem Content="All Jobs"/>
            <ComboBoxItem Content="Unassigned Jobs"/>
            <ComboBoxItem Content="Assigned Only"/>
            <ComboBoxItem Content="Completed Jobs"/>
        </ComboBox>

        <Button x:Name="Button_CompleteJob"
            Content="Complete Selected Job"
            Width="132"
            Height="27"
            Click="Button_CompleteJob_Click" 
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="489,376,0,0"/>

        <!-- Job List View -->
        <Label Content="View Jobs:" 
           HorizontalAlignment="Left" 
           Margin="250,252,0,0" 
           VerticalAlignment="Top"/>

        <ListBox x:Name="Jobs_ListBox" 
             Margin="250,294,185,248" 
             SelectionMode="Single"/>

        <!-- === JOB MANAGEMENT: Creation and Search === -->

        <!-- Job Creation Inputs (Moved down for clear space) -->
        <StackPanel HorizontalAlignment="Left" 
        Margin="10,250,0,0" 
        VerticalAlignment="Top" 
        Width="216">

            <Label Content="Job Management" 
        FontWeight="Bold" 
        FontSize="14" 
        Margin="0,0,0,5"/>

            <StackPanel Orientation="Horizontal" Margin="0,5,0,5">
                <Label Content="Job Title:" Width="80" VerticalAlignment="Center"/>
                <TextBox x:Name="JobTitle_TextBox" 
             Width="132" 
             TextWrapping="Wrap" 
             Height="23"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,5,0,10">
                <Label Content="Agreed Cost ($):" Width="100" VerticalAlignment="Center"/>
                <TextBox x:Name="AgreedCostBox" 
             Width="113" 
             TextWrapping="Wrap" 
             Height="23"/>
            </StackPanel>

            <Button x:Name="Button_AddJob" 
        Content="Add New Job" 
        HorizontalAlignment="Left" 
        Width="120"
        Height="27"
        Click="Button_AddJob_Click"
        Margin="0,5,0,10"/>

        </StackPanel>

        <!-- Job Search by Cost -->
        <StackPanel HorizontalAlignment="Left" 
        Margin="11,469,0,0" 
        VerticalAlignment="Top" 
        Width="216">

            <Label Content="Search Jobs by Cost" 
            FontWeight="Bold" 
            FontSize="14" 
            />

            <StackPanel Orientation="Horizontal" Margin="0,5,0,5">
                <Label Content="Min Cost ($):" Width="80" VerticalAlignment="Center"/>
                <TextBox x:Name="MinCost_TextBox" 
                     Width="120" 
                     TextWrapping="Wrap" 
                     Height="23"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,5,0,5">
                <Label Content="Max Cost ($):" Width="80" VerticalAlignment="Center"/>
                <TextBox x:Name="MaxCost_TextBox" 
                     Width="120" 
                     TextWrapping="Wrap" 
                     Height="23"/>
            </StackPanel>

            <Button x:Name="Button_SearchCost"
                Content="Search Jobs"
                Click="Button_SearchCost_Click"
                Margin="0,10,0,0"
                Width="140"/>
        </StackPanel>

        <!-- Search Results List -->
        <ListBox x:Name="SearchResults_ListBox"
             Margin="250,458,29,69"  
             DisplayMemberPath="JobInfo"
             SelectionMode="Single"
             ScrollViewer.VerticalScrollBarVisibility="Visible"/>

    </Grid>
</Window>